{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@photobooth/domain": ["../../packages/domain/src/index.ts"],
      "@photobooth/storage": ["../../packages/storage/src/index.ts"],
      "@photobooth/compositor": ["../../packages/compositor/src/index.ts"],
