{
  "name": "@photobooth/desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Offline-first desktop photobooth for Collaboration Day 2026.",
  "author": {
    "name": "Arifian Ilham Nur",
    "email": "arifianilhamnur@gmail.com"
  },
  "homepage": "https://photobooth.collaborationday2026.web.id",
  "desktopName": "collaboration-day-photobooth",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron-vite dev\"",
    "build": "electron-vite build",
    "dist": "npm run build && electron-builder",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@photobooth/camera": "*",
    "@photobooth/compositor": "*",
    "@photobooth/domain": "*",
    "@photobooth/drive": "*",
    "@photobooth/storage": "*",
    "@img/sharp-libvips-linux-x64": "1.2.4",
    "@img/sharp-linux-x64": "0.34.5",
    "googleapis": "^178.0.0",
    "node-addon-api": "^8.5.0",
    "nodemailer": "^7.0.5",
    "sharp": "^0.34.4",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/nodemailer": "^7.0.3",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "electron": "44.2.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "node-gyp": "^11.5.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^4.0.0",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.collaborationday.photobooth",
    "productName": "Collaboration Day Photobooth",
    "executableName": "collaboration-day-photobooth",
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Graphics",
      "icon": "resources/icon.png",
      "maintainer": "Arifian Ilham Nur <arifianilhamnur@gmail.com>",
      "syncDesktopName": true
    },
    "deb": {
      "packageName": "collaboration-day-photobooth",
      "artifactName": "collaboration-day-photobooth_${version}_${arch}.${ext}"
    },
    "directories": {
      "output": "release"
    },
    "asar": false,
    "files": [
      "dist/**",
      "out/renderer/**",
      "resources/**",
      "../../packages/**/src/**",
      "package.json"
    ],
    "electronVersion": "44.2.0",
    "extraResources": [
      {
        "from": "src/renderer/assets/frames",
        "to": "frames"
      },
      {
        "from": "resources/render-strip.cjs",
        "to": "render-strip.cjs"
      }
    ],
    "win": {
      "target": ["nsis"],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
